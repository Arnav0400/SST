{
  "paper": "Sculpting Subspaces: Constrained Full Fine-Tuning in LLMs for Continual Learning",
  "source": "https://arxiv.org/abs/2504.07097",
  "backbone": "LLaMA-2-7B",
  "hardware": "8 x NVIDIA H100",
  "deepspeed_stage": 2,
  "per_device_batch_size": 1,
  "effective_batch_size": 8,
  "learning_rate": 0.00001,
  "weight_decay": 0.01,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-08,
  "epochs_per_task": 1,
  "gradient_checkpointing": true,
  "minimum_retention_ratio": 0.1,
  "target_retention_ratio": 0.8,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "update_rule": "project gradients after backpropagation into the permitted low-rank subspace",
  "rank_policy": "adaptive layer importance"
}
