{
  "paper": "OPLoRA: Orthogonal Subspace Learning for Language Model Continual Learning",
  "source": "https://arxiv.org/abs/2510.13003",
  "backbones": [
    "LLaMA-2-7B",
    "Qwen2.5-7B"
  ],
  "projection_ranks": [
    16,
    128
  ],
  "target_modules": [
    "q_proj",
    "v_proj",
    "up_proj",
    "down_proj",
    "o_proj"
  ],
  "shared": {
    "lora_dropout": 0.05,
    "batch_size": 32,
    "epochs": 1,
    "weight_decay": 0.0,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03,
    "precision": "bfloat16"
  },
  "domain_overrides": {
    "commonsense": {
      "lora_rank": 32,
      "lora_alpha": 32,
      "learning_rate": 0.0002
    },
    "math": {
      "lora_rank": 64,
      "lora_alpha": 64,
      "learning_rate": 0.0003
    },
    "python": {
      "lora_rank": 32,
      "lora_alpha": 32,
      "learning_rate": 0.0002
    }
  }
}
